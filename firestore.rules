rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.uid == "m7pkPGN62YMWfPr7ftbSMw3jv052"
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        );
    }

    function sameEmail(emailId) {
      return signedIn()
        && request.auth.token.email != null
        && emailId == request.auth.token.email;
    }

    function customerDoc(emailId) {
      return get(/databases/$(database)/documents/customers/$(emailId));
    }

    function activeCustomer(emailId) {
      let c = customerDoc(emailId);
      return sameEmail(emailId)
        && c.exists()
        && c.data.status == "ACTIVE"
        && (
          c.data.durationDays == 0
          || c.data.expiryDate == null
          || c.data.expiryDate > request.time
        );
    }

    function slotAllowed(slot) {
      return slot == "1" || slot == "2" || slot == "3";
    }

    match /admins/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, create, update, delete: if isAdmin();
    }

    // The Google account used at the moment of first successful activation
    // becomes the permanent master account for that membership.
    match /customers/{emailId} {
      allow get: if isAdmin() || sameEmail(emailId);
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        sameEmail(emailId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "ACTIVE"
        && request.resource.data.source == "ACTIVATION_KEY"
        && request.resource.data.activationKeyId is string
        && request.resource.data.activationKeyId != ""
        && keyAfter(request.resource.data.activationKeyId).data.status == "REDEEMED"
        && keyAfter(request.resource.data.activationKeyId).data.redeemedEmail == request.auth.token.email
        && keyAfter(request.resource.data.activationKeyId).data.redeemedByUid == request.auth.uid
        && request.resource.data.planId == keyAfter(request.resource.data.activationKeyId).data.planId
        && request.resource.data.planName == keyAfter(request.resource.data.activationKeyId).data.planName
        && request.resource.data.price == keyAfter(request.resource.data.activationKeyId).data.price
        && request.resource.data.offerPrice == keyAfter(request.resource.data.activationKeyId).data.offerPrice
        && request.resource.data.durationDays == keyAfter(request.resource.data.activationKeyId).data.durationDays
        && request.resource.data.deviceLimit == 3
        && request.resource.data.shippingEnabled == keyAfter(request.resource.data.activationKeyId).data.shippingEnabled
        && request.resource.data.startDate <= request.time
        && request.resource.data.startDate >= request.time - duration.value(10, "m")
        && (
          request.resource.data.durationDays == 0
            ? request.resource.data.expiryDate == null
            : request.resource.data.expiryDate == request.resource.data.startDate + duration.value(request.resource.data.durationDays, "d")
        )
      );

      allow update: if isAdmin()
        || (
          sameEmail(emailId)
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "displayName", "uid", "lastLoginAt", "updatedAt"
          ])
        )
        || (
          sameEmail(emailId)
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == "ACTIVE"
          && request.resource.data.source == "ACTIVATION_KEY"
          && request.resource.data.activationKeyId is string
          && request.resource.data.activationKeyId != resource.data.activationKeyId
          && keyAfter(request.resource.data.activationKeyId).data.status == "REDEEMED"
          && keyAfter(request.resource.data.activationKeyId).data.redeemedEmail == request.auth.token.email
          && keyAfter(request.resource.data.activationKeyId).data.redeemedByUid == request.auth.uid
          && request.resource.data.planId == keyAfter(request.resource.data.activationKeyId).data.planId
          && request.resource.data.planName == keyAfter(request.resource.data.activationKeyId).data.planName
          && request.resource.data.price == keyAfter(request.resource.data.activationKeyId).data.price
          && request.resource.data.offerPrice == keyAfter(request.resource.data.activationKeyId).data.offerPrice
          && request.resource.data.durationDays == keyAfter(request.resource.data.activationKeyId).data.durationDays
          && request.resource.data.deviceLimit == 3
          && request.resource.data.shippingEnabled == keyAfter(request.resource.data.activationKeyId).data.shippingEnabled
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "planId", "planName", "price", "offerPrice", "durationDays", "status",
            "shippingEnabled", "deviceLimit", "startDate", "expiryDate",
            "activationKeyId", "source", "activatedAt", "updatedAt"
          ])
          && request.resource.data.startDate == (
            resource.data.expiryDate != null && resource.data.expiryDate > request.time
              ? resource.data.expiryDate
              : request.time
          )
          && (
            request.resource.data.durationDays == 0
              ? request.resource.data.expiryDate == null
              : request.resource.data.expiryDate == request.resource.data.startDate + duration.value(request.resource.data.durationDays, "d")
          )
        );

      allow delete: if isAdmin();
    }

    match /customers/{emailId}/devices/{slot} {
      allow read: if isAdmin() || sameEmail(emailId);

      allow create: if isAdmin() || (
        activeCustomer(emailId)
        && slotAllowed(slot)
        && customerDoc(emailId).data.deviceLimit == 3
        && request.resource.data.email == emailId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.slot == slot
        && request.resource.data.deviceId is string
        && request.resource.data.status == "ACTIVE"
      );

      allow update: if isAdmin() || (
        activeCustomer(emailId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.slot == resource.data.slot
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "deviceLabel", "platform", "browser", "lastActiveAt", "updatedAt"
        ])
      );

      allow delete: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    function keyAfter(code) {
      return getAfter(/databases/$(database)/documents/activationKeys/$(code));
    }

    match /activationKeys/{code} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (
        signedIn()
        && resource.data.status == "AVAILABLE"
        && resource.data.keyExpiresAt > request.time
      );
      allow create, delete: if isAdmin();

      // A key is not tied to any Gmail when created. It becomes bound to the
      // currently authenticated Google account only when redeemed.
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.status == "AVAILABLE"
        && resource.data.keyExpiresAt > request.time
        && request.resource.data.status == "REDEEMED"
        && request.resource.data.code == resource.data.code
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.planName == resource.data.planName
        && request.resource.data.price == resource.data.price
        && request.resource.data.offerPrice == resource.data.offerPrice
        && request.resource.data.durationDays == resource.data.durationDays
        && request.resource.data.shippingEnabled == resource.data.shippingEnabled
        && request.resource.data.deviceLimit == 3
        && request.resource.data.keyExpiresAt == resource.data.keyExpiresAt
        && request.resource.data.redeemedByUid == request.auth.uid
        && request.resource.data.redeemedEmail == request.auth.token.email
        && request.resource.data.redeemedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "redeemedByUid", "redeemedEmail", "redeemedAt"
        ])
      );
    }

    // No payments, promoCodes, users, memberships, or top-level devices.
    // Any unmatched/legacy document is denied by default.
  }
}

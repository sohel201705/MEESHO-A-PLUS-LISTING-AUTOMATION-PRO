rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

        function isAdmin() {
      return signedIn()
        && (
          request.auth.uid == "m7pkPGN62YMWfPr7ftbSMw3jv052"
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        );
    }

    function sameEmail(emailId) {
      return signedIn()
        && request.auth.token.email != null
        && emailId == request.auth.token.email;
    }

    function customerDoc(emailId) {
      return get(/databases/$(database)/documents/customers/$(emailId));
    }

    function customerAfter(emailId) {
      return getAfter(/databases/$(database)/documents/customers/$(emailId));
    }

    function keyAfter(code) {
      return getAfter(/databases/$(database)/documents/activationKeys/$(code));
    }

    function activeCustomer(emailId) {
      let c = customerDoc(emailId);
      return sameEmail(emailId)
        && c.exists()
        && c.data.status == "ACTIVE"
        && (
          c.data.durationDays == 0
          || c.data.expiryDate == null
          || c.data.expiryDate > request.time
        );
    }

    function slotAllowed(slot, deviceLimit) {
      return (slot == "1" && deviceLimit >= 1)
        || (slot == "2" && deviceLimit >= 2)
        || (slot == "3" && deviceLimit >= 3)
        || (slot == "4" && deviceLimit >= 4)
        || (slot == "5" && deviceLimit >= 5)
        || (slot == "6" && deviceLimit >= 6)
        || (slot == "7" && deviceLimit >= 7)
        || (slot == "8" && deviceLimit >= 8)
        || (slot == "9" && deviceLimit >= 9)
        || (slot == "10" && deviceLimit >= 10)
        || (slot == "11" && deviceLimit >= 11)
        || (slot == "12" && deviceLimit >= 12)
        || (slot == "13" && deviceLimit >= 13)
        || (slot == "14" && deviceLimit >= 14)
        || (slot == "15" && deviceLimit >= 15)
        || (slot == "16" && deviceLimit >= 16)
        || (slot == "17" && deviceLimit >= 17)
        || (slot == "18" && deviceLimit >= 18)
        || (slot == "19" && deviceLimit >= 19)
        || (slot == "20" && deviceLimit >= 20);
    }

    match /admins/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, create, update, delete: if isAdmin();
    }

    // EMAIL IS THE CUSTOMER ACCOUNT KEY. Firebase UID is metadata/device identity only; membership is never selected by UID.
    match /customers/{emailId} {
      allow get: if isAdmin() || sameEmail(emailId);
      allow list: if isAdmin();

      // First login creates a clean, non-membership customer profile.
      allow create: if isAdmin() || (
        sameEmail(emailId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "NOT_ACTIVATED"
        && request.resource.data.deviceLimit >= 1
        && request.resource.data.deviceLimit <= 20
        && request.resource.data.diff({}).affectedKeys().hasOnly([
          "email",
          "name",
          "displayName",
          "uid",
          "status",
          "deviceLimit",
          "createdAt",
          "lastLoginAt",
          "updatedAt"
        ])
      ) || (
        // Activation/renewal is valid only when the same atomic write redeems
        // a key issued to this exact email.
        sameEmail(emailId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "ACTIVE"
        && request.resource.data.source == "ACTIVATION_KEY"
        && request.resource.data.activationKeyId is string
        && request.resource.data.activationKeyId != ""
        && keyAfter(request.resource.data.activationKeyId).data.status == "REDEEMED"
        && keyAfter(request.resource.data.activationKeyId).data.targetEmail == request.auth.token.email
        && keyAfter(request.resource.data.activationKeyId).data.redeemedEmail == request.auth.token.email
        && keyAfter(request.resource.data.activationKeyId).data.redeemedByUid == request.auth.uid
        && request.resource.data.planId == keyAfter(request.resource.data.activationKeyId).data.planId
        && request.resource.data.planName == keyAfter(request.resource.data.activationKeyId).data.planName
        && request.resource.data.price == keyAfter(request.resource.data.activationKeyId).data.price
        && request.resource.data.offerPrice == keyAfter(request.resource.data.activationKeyId).data.offerPrice
        && request.resource.data.durationDays == keyAfter(request.resource.data.activationKeyId).data.durationDays
        && request.resource.data.deviceLimit == keyAfter(request.resource.data.activationKeyId).data.deviceLimit
        && request.resource.data.startDate <= request.time
        && request.resource.data.startDate >= request.time - duration.value(10, "m")
        && (
          request.resource.data.durationDays == 0
            ? request.resource.data.expiryDate == null
            : request.resource.data.expiryDate == request.resource.data.startDate + duration.value(request.resource.data.durationDays, "d")
        )
      );

      allow update: if isAdmin()
        || (
          // Profile/session updates are email-owned. UID may change on another device.
          sameEmail(emailId)
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "displayName",
            "uid",
            "lastLoginAt",
            "updatedAt"
          ])
        )
        || (
          sameEmail(emailId)
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == "ACTIVE"
          && request.resource.data.source == "ACTIVATION_KEY"
          && request.resource.data.activationKeyId is string
          && (
            resource.data.status != "ACTIVE"
            || !(resource.data.activationKeyId is string)
            || request.resource.data.activationKeyId != resource.data.activationKeyId
          )
          && keyAfter(request.resource.data.activationKeyId).data.status == "REDEEMED"
          && keyAfter(request.resource.data.activationKeyId).data.targetEmail == request.auth.token.email
          && keyAfter(request.resource.data.activationKeyId).data.redeemedEmail == request.auth.token.email
          && keyAfter(request.resource.data.activationKeyId).data.redeemedByUid == request.auth.uid
          && request.resource.data.planId == keyAfter(request.resource.data.activationKeyId).data.planId
          && request.resource.data.planName == keyAfter(request.resource.data.activationKeyId).data.planName
          && request.resource.data.price == keyAfter(request.resource.data.activationKeyId).data.price
          && request.resource.data.offerPrice == keyAfter(request.resource.data.activationKeyId).data.offerPrice
          && request.resource.data.durationDays == keyAfter(request.resource.data.activationKeyId).data.durationDays
          && request.resource.data.deviceLimit == keyAfter(request.resource.data.activationKeyId).data.deviceLimit
          && request.resource.data.startDate == (
            resource.data.expiryDate != null && resource.data.expiryDate > request.time
              ? resource.data.expiryDate
              : request.time
          )
          && (
            request.resource.data.durationDays == 0
              ? request.resource.data.expiryDate == null
              : request.resource.data.expiryDate == request.resource.data.startDate + duration.value(request.resource.data.durationDays, "d")
          )
        );

      allow delete: if isAdmin();
    }

    match /customers/{emailId}/devices/{slot} {
      allow read: if isAdmin() || sameEmail(emailId);

      allow create: if isAdmin() || (
        activeCustomer(emailId)
        && slotAllowed(slot, customerDoc(emailId).data.deviceLimit)
        && request.resource.data.email == emailId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.slot == slot
        && request.resource.data.deviceId is string
        && request.resource.data.status == "ACTIVE"
      );

      allow update: if isAdmin() || (
        activeCustomer(emailId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.slot == resource.data.slot
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "deviceLabel",
          "platform",
          "browser",
          "lastActiveAt",
          "updatedAt"
        ])
      );

      allow delete: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /activationKeys/{code} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (
        signedIn()
        && resource.data.status == "AVAILABLE"
        && resource.data.targetEmail == request.auth.token.email
        && resource.data.keyExpiresAt > request.time
      );
      allow create, delete: if isAdmin();

      // The customer can redeem only the key issued to their email, and only
      // inside the same atomic batch that creates/updates their customer record.
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.status == "AVAILABLE"
        && resource.data.targetEmail == request.auth.token.email
        && resource.data.keyExpiresAt > request.time
        && request.resource.data.status == "REDEEMED"
        && request.resource.data.code == resource.data.code
        && request.resource.data.targetEmail == resource.data.targetEmail
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.planName == resource.data.planName
        && request.resource.data.price == resource.data.price
        && request.resource.data.offerPrice == resource.data.offerPrice
        && request.resource.data.durationDays == resource.data.durationDays
        && request.resource.data.shippingEnabled == resource.data.shippingEnabled
        && request.resource.data.deviceLimit == resource.data.deviceLimit
        && request.resource.data.keyExpiresAt == resource.data.keyExpiresAt
        && request.resource.data.redeemedByUid == request.auth.uid
        && request.resource.data.redeemedEmail == request.auth.token.email
        && request.resource.data.redeemedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "redeemedByUid",
          "redeemedEmail",
          "redeemedAt"
        ])
      );
    }

    // No payments, promoCodes, users, memberships, or top-level devices.
    // Any unmatched/legacy document is denied by default.
  }
}
